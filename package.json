{
  "name": "marquee",
  "private": true,
  "version": "0.1.4",
  "description": "New movies, shows, games and albums, picked for your taste.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "cross-env VITE_MOCK=1 vite",
    "build": "tsc --noEmit && vite build",
    "build:mock": "cross-env VITE_MOCK=1 vite build --outDir dist-mock",
    "preview:mock": "vite preview --outDir dist-mock --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "icons": "node scripts/make-icons.mjs && tauri icon src-tauri/icons/app-icon.png",
    "tauri": "tauri",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "set-version": "node scripts/set-version.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.5",
    "@tanstack/react-query": "^5.90.0",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-autostart": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "framer-motion": "^12.23.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tauri-apps/cli": "^2.9.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "cross-env": "^10.1.0",
    "eslint": "^9.38.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.4.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
