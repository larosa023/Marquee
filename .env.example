# App-level keys. Copy this file to .env and fill in what you have; .env is git-ignored.
# The build bakes these into the app (src-tauri/build.rs) so it works out of the box.
# Anything left empty can be entered later in Settings → API keys, where it is stored in
# Windows Credential Manager. README.md → "API keys" explains where to get each one.

# Movies and TV (required for both). https://www.themoviedb.org/settings/api  → "API Key (v3 auth)"
TMDB_API_KEY=

# Games catalog (IGDB, through Twitch). https://dev.twitch.tv/console/apps
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Music: similar artists, tags, scrobbles. https://www.last.fm/api/account/create
LASTFM_API_KEY=
LASTFM_API_SECRET=

# Spotify sign-in. https://developer.spotify.com/dashboard
# Redirect URI to register: http://127.0.0.1:43117/spotify
SPOTIFY_CLIENT_ID=

# Trakt sign-in. https://trakt.tv/oauth/applications   Redirect URI: urn:ietf:wg:oauth:2.0:oob
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=

# Steam library, playtime and wishlist. https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Optional: all-time low game prices. https://isthereanydeal.com/apps/my/
ITAD_API_KEY=
